# Veritabanı. Lokal geliştirmede `npm run db` bu adreste gömülü Postgres açar.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eticaret"

# Sitenin dışarıdan erişilen adresi (ödeme dönüşleri, e-posta linkleri, feed URL'leri için)
APP_URL="http://localhost:3000"

# Oturum ve imzalı çerezler için en az 32 karakter rastgele değer
AUTH_SECRET="degistir-bunu-en-az-32-karakter-rastgele-deger"

# Zamanlanmış işleri dışarıdan tetiklemek için (/api/cron?key=...)
CRON_SECRET="degistir-bunu-cron"

# Dosya depolama: local | s3
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# E-posta: boş bırakılırsa e-postalar sadece panelde "Giden Kutusu"na yazılır
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# iyzico (sandbox: https://sandbox-api.iyzipay.com)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
